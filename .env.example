# Copy to .env and fill in before `docker compose up`.
# Never commit .env.

# Players — either one shared token, or per-person label:secret pairs
CTF_MCP_AUTH_TOKEN=change-me-team-token
# CTF_MCP_AUTH_TOKENS=alice:secret-a,bob:secret-b

# Coach visibility on the Challenge Desk (Josh) — keep private
CTF_MCP_COACH_TOKEN=change-me-coach-token

# URL teammates open in the browser / paste into Claude/Cursor
CTF_MCP_PUBLIC_URL=http://127.0.0.1:8765

# Host headers allowed when not only on loopback (Tailscale IP/name)
# CTF_MCP_ALLOWED_HOSTS=100.64.0.10:8765,ctf-mcp:8765,127.0.0.1:*

# Event knobs
# CTF_FLAG_REGEX=MUCTF\{[^}]+\}
# CTF_SCOPE=*.ctf.example.edu,10.10.0.0/16
